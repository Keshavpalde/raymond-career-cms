                                                }
                                            ]
                        },
    "madeForMoreIntro":  {
                             "id":  17,
                             "heading":  "MADE FOR MORE",
                             "description":  [
                                                 {
                                                     "type":  "paragraph",
                                                     "children":  [
                                                                      {
                                                                          "type":  "text",
                                                                          "text":  "At Raymond Realty, growth is about more than career progression—it\u0027s about continuous learning, meaningful recognition, personal wellbeing, and creating opportunities to thrive. We believe every employee deserves an environment where they feel valued, empowered, and inspired to achieve their full potential."
                                                                      }
                                                                  ]
                                                 },
                                                 {
                                                     "type":  "paragraph",
                                                     "children":  [
                                                                      {
                                                                          "type":  "text",
                                                                          "text":  "As a Great Place to Work®, we nurture a culture where every contribution matters and every individual is encouraged to become #MadeForMore."
                                                                      }
                                                                  ]
                                                 }
                                             ]
                         },
    "learnAndGrow":  {
